# Copy to .env (repo root). Every app reads this one file.

# Postgres (docker compose). Host port 5433 so it does not clash with a local Postgres on 5432.
POSTGRES_USER=sonrisa
POSTGRES_PASSWORD=sonrisa
POSTGRES_DB=sonrisa
POSTGRES_PORT=5433
# Keep the port in DATABASE_URL in sync with POSTGRES_PORT.
DATABASE_URL=postgresql://sonrisa:sonrisa@localhost:5433/sonrisa

# API (NestJS); the web dev server proxies /api to this port
API_PORT=3000
# JWT signing key (HS256), at least 32 characters. The API refuses to start without it.
# Generate one: openssl rand -base64 48
JWT_SECRET=
# Token lifetime in seconds (default 12 h)
# JWT_TTL_SECONDS=43200

# Mailpit (docker compose): SMTP for the Email channel, UI at http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# The Email channel's SMTP server (Mailpit locally). From address of the emails.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# MAIL_FROM=World Event Alerts <alerts@sonrisa.test>

# Slack Stand-in (docker compose): web view and webhooks at http://localhost:4010 (D12).
SLACK_STANDIN_PORT=4010
# Slack webhooks may point only at https://hooks.slack.com/services/… or this origin (SSRF guard).
# Empty = real Slack only. Keep the port in sync with SLACK_STANDIN_PORT.
SLACK_STANDIN_URL=http://localhost:4010
# Delivery retries: 3 attempts; the first retry waits this long, the next twice as long.
# DELIVERY_RETRY_BASE_SECONDS=30

# Ingestion scheduler (USGS / GDACS polling). `off` keeps the API from calling the real feeds;
# "poll now" in the admin API still works.
# INGESTION_SCHEDULER=on
