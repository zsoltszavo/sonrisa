{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Playwright loads the .ts files itself; tsc only checks them.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["*.ts", "tests"]
}
